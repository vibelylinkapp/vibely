# =====================================================================
# Vibely environment variables
# Copy to .env.local for development. In production set them in
# Vercel -> Project Settings -> Environment Variables.
# NEVER commit real values. Only NEXT_PUBLIC_* values reach the browser.
# =====================================================================

# --- Site -------------------------------------------------------------
# Canonical public URL (no trailing slash). Used for SEO, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://vibely-inky.vercel.app

# --- Supabase (Project Settings -> API) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security - never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sessions ---------------------------------------------------------
# Sign members out after this many days without any activity (default 30).
SESSION_IDLE_DAYS=30

# --- Admin ------------------------------------------------------------
# Secret base path of the admin panel (no slashes). Set a long random value.
ADMIN_PANEL_PATH=

# --- Cron (Vercel Cron sends Authorization: Bearer <CRON_SECRET>) -----
CRON_SECRET=

# --- M-Pesa Daraja (developer.safaricom.co.ke) ------------------------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
# Required: long random string. Payments callbacks are refused without it.
MPESA_CALLBACK_SECRET=

# --- Paystack (host payouts) ------------------------------------------
PAYSTACK_SECRET_KEY=

# --- Web Push (generate with: npx web-push generate-vapid-keys) -------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@vibely.co.ke

# --- Feature flags (true/false) ---------------------------------------
NEXT_PUBLIC_FEATURE_STORIES=false
NEXT_PUBLIC_FEATURE_FEED=false
NEXT_PUBLIC_FEATURE_HEATMAP=false
NEXT_PUBLIC_FEATURE_TOP_MATCHES=false
NEXT_PUBLIC_FEATURE_BOOSTS=false
NEXT_PUBLIC_FEATURE_CHAT_TAB=false
